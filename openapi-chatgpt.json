         "politica": {
          "type": "object",
          "properties": {
           "horarios": {
            "type": "array",
            "items": {
             "type": "string",
             "description": "HH:MM"
            }
           },
           "dias": {
            "type": "array",
            "items": {
             "type": "integer"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
