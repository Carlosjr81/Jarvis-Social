     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "versao"
        ],
        "properties": {
         "versao": {
          "type": "integer"
         },
         "legenda": {
          "type": "string"
         },
         "data": {
          "type": "string",
          "description": "AAAA-MM-DD, fuso do espaço"
         },
         "hora": {
          "type": "string",
          "description": "HH:MM"
         }
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "post_id"
     }
    ]
   }
  },
