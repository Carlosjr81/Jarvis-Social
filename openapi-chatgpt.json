  "/v1/frequencia/previa": {
   "post": {
    "operationId": "previaFrequencia",
    "summary": "Prévia da frequência",
    "description": "O que muda na grade com novos horários/dias. Mostre ao dono antes de aplicar.",
    "responses": {
     "200": {
