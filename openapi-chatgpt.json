{
 "openapi": "3.1.0",
 "info": {
  "title": "Jarvis Social — grade de Reels",
  "version": "2026-11-22h",
  "description": "Ações para um GPT gerenciar a grade de Reels do Instagram pelo Jarvis Social. Autenticação: chave de integração (Bearer js_...) criada no painel."
 },
 "servers": [
  {
   "url": "https://klbthlkalucoeoemipxm.supabase.co/functions/v1/api"
  }
 ],
 "components": {
  "securitySchemes": {
   "chave": {
    "type": "http",
    "scheme": "bearer"
   }
  },
  "schemas": {}
 },
 "security": [
  {
   "chave": []
  }
 ],
 "paths": {
  "/v1/grade": {
   "get": {
    "operationId": "verGrade",
    "summary": "Grade de publicação futura",
    "description": "Horários da frequência nos próximos dias, livres ou ocupados, posts fora da grade e rascunhos esperando. Use primeiro.",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "dias",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 60
      }
     }
    ]
   }
  },
  "/v1/grade/preencher": {
   "post": {
    "operationId": "preencherGrade",
    "summary": "Preencher a grade",
    "description": "Encaixa os rascunhos com vídeo nos próximos horários livres.",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "post_ids": {
          "type": "array",
          "items": {
           "type": "string"
          }
         },
         "limite": {
          "type": "integer"
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/posts": {
   "get": {
    "operationId": "verAgenda",
    "summary": "Agenda",
    "description": "Publicações entre duas datas (ou por estado, ex.: estado=draft para rascunhos).",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "de",
      "in": "query",
      "schema": {
       "type": "string",
       "description": "AAAA-MM-DD, fuso do espaço"
      }
     },
     {
      "name": "ate",
      "in": "query",
      "schema": {
       "type": "string",
       "description": "AAAA-MM-DD, fuso do espaço"
      }
     },
     {
      "name": "estado",
      "in": "query",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "incluir_rascunhos",
      "in": "query",
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "post": {
    "operationId": "criarRascunho",
    "summary": "Criar rascunho",
    "description": "Rascunho a partir de um vídeo da biblioteca (agendar=false). chave_idempotencia única por pedido.",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "video_id",
         "legenda",
         "chave_idempotencia"
        ],
        "properties": {
         "video_id": {
          "type": "string"
         },
         "capa_id": {
          "type": "string"
         },
         "conta_id": {
          "type": "string"
         },
         "legenda": {
          "type": "string"
         },
         "agendar": {
          "type": "boolean"
         },
         "chave_idempotencia": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/posts/{id}": {
   "get": {
    "operationId": "verPublicacao",
    "summary": "Ver publicação",
    "description": "Detalhes, histórico e recibo (permalink quando publicada).",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "description": "post_id"
     }
    ]
   },
   "patch": {
    "operationId": "editarPublicacao",
    "summary": "Editar publicação",
    "description": "Muda legenda e/ou data e hora. Exige a versao atual (leia com verPublicacao).",
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
